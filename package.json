{
  "name": "siderealsystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "download:data": "tsx scripts/download/all.ts",
    "download:hipparcos": "tsx scripts/download/hipparcos.ts",
    "download:bsc": "tsx scripts/download/bsc.ts",
    "download:iau-star-names": "tsx scripts/download/iau-star-names.ts",
    "download:iau-constellation-boundaries": "tsx scripts/download/iau-constellation-boundaries.ts",
    "download:openngc": "tsx scripts/download/openngc.ts",
    "download:wmm": "tsx scripts/download/wmm.ts",
    "build:data": "tsx scripts/build/closeup-stars.ts && tsx scripts/build/wmm.ts",
    "build:closeup-stars": "tsx scripts/build/closeup-stars.ts",
    "build:wmm": "tsx scripts/build/wmm.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.9",
    "adm-zip": "^0.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
